# AWS credentials — use IAM roles in production; never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Optional: restrict CORS to your frontend origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default Bedrock model (overridable via API)
DEFAULT_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
DEFAULT_PROVIDER=bedrock

# Optional: pre-configure a local OpenAI-compatible endpoint (Ollama, vLLM, etc.)
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_TOKEN=
# LOCAL_LLM_MODEL=llama3.2

# Server
HOST=0.0.0.0
PORT=8000

# Persisted LLM config (SQLite). Local API tokens are encrypted at rest.
# CONFIG_DB_PATH=backend/data/playground.db
# Fernet key (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# CONFIG_ENCRYPTION_KEY=
# Or auto-generated file on first run (single-node dev):
# CONFIG_ENCRYPTION_KEY_FILE=backend/data/.fernet_key
